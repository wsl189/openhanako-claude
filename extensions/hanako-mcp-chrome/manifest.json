{
  "manifest_version": 3,
  "name": "Claude Core MCP Browser Bridge",
  "description": "Local Chrome extension bridge for Claude Core MCP (no Anthropic account required).",
  "version": "0.1.0",
  "key": "",
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "windows",
    "scripting",
    "storage",
    "downloads",
    "debugger",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Claude Core MCP Browser Bridge"
  },
  "minimum_chrome_version": "120"
}
